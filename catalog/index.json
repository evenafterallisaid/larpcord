      "id": "bot-marker",
      "name": "Bot Marker",
      "version": "1.0.0",
      "description": "Label bot and app messages in chat.",
      "permissions": ["message_metadata"],
      "message_decorators": [
        {"when": {"author_bot": true}, "label": "Automated", "color": 10143474}
      ]
